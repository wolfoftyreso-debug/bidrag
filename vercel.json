{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build -w packages/core -w apps/api -w apps/web && node --experimental-strip-types tools/genseo.mjs --out apps/web/dist",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm ci --no-audit --no-fund",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/healthz",
      "destination": "/api/index"
    },
    {
      "source": "/readyz",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|favicon|bidrag/|oppna-bidrag/|en/bidrag/|es/bidrag/|fr/bidrag/|ar/bidrag/|fa/bidrag/|prs/bidrag/|ru/bidrag/|uk/bidrag/|so/bidrag/|ti/bidrag/|hitta-bidrag-gratis/|vilka-bidrag-kan-jag-fa/|bidragsstatus/|finansiarer/|foretagsbidragsindex/|foretag/|privatperson/|forening/|enskild-firma/|og/|icon-|site\\.webmanifest|sitemap\\.xml|robots\\.txt|404).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/v1/internal/cron/source-fetch",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/v1/internal/cron/deadline-scan",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/v1/internal/cron/stale-match-recalc",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/v1/internal/cron/curator-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/v1/internal/cron/retention",
      "schedule": "30 4 * * *"
    }
  ]
}

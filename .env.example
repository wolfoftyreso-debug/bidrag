# Bidragskoll.se — miljövariabler. Kopiera till .env.local för lokal utveckling.
# COMMITTA ALDRIG riktiga värden. Produktionsvärden läggs i Vercels
# Environment Variables (separata värden för Development/Preview/Production).
# En hemlighet som råkat hamna i Git är komprometterad och SKA roteras.

# ── Databas (Neon / Vercel Postgres) ─────────────────────────────────────────
# Runtime: poolad anslutning (Neon pooler, host ...-pooler.neon.tech, sslmode=require).
DATABASE_URL=
# Migreringar/seed: direktanslutning (icke-poolad host) — kör aldrig migreringar via poolern.
DIRECT_DATABASE_URL=
# Serverless: håll poolen liten per funktionsinstans.
PG_POOL_MAX=2

# ── Auth & kryptering ────────────────────────────────────────────────────────
# Minst 32 tecken; rotera vid misstanke om läckage.
AUTH_SECRET=
# 32 byte hex (64 tecken) för fältkryptering av externa identifierare.
FIELD_ENCRYPTION_KEY=

# ── Applikation ──────────────────────────────────────────────────────────────
# Lokal utveckling: sätt PORT=3100 — vite-proxyn (apps/web) och alla
# verifieringsverktyg i tools/ antar API:t på :3100 (kodens default är 3000).
PORT=3100
PUBLIC_BASE_URL=
CORS_ORIGIN=
LOG_LEVEL=info
RATE_LIMIT_MAX=300
# Per-IP-tak per minut för hela API:t. Händelseloggen /v1/events har ett eget tak
# max(60, RATE_LIMIT_MAX/5); registrering/lösenord har fasta 5–10/min.
# Belastningstest (scripts/loadtest.mjs): sätt t.ex. 1000000 så mäts kapaciteten, inte vakten.

# ── Lagring (dokumentvalvet) ─────────────────────────────────────────────────
# 'disk' lokalt/i container (kräver persistent volym); 'postgres' på Vercel+Neon
# (filerna bor i databasen — fullständigt privat, ingen publik URL, överlever
# serverless); 'supabase' finns kvar som alternativ (privat bucket, service-nyckel
# enbart server-side). På Vercel: STORAGE_DRIVER=postgres.
STORAGE_DRIVER=disk
UPLOAD_DIR=./uploads
# Endast om STORAGE_DRIVER=supabase:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ── Bakgrundsjobb ────────────────────────────────────────────────────────────
# Container: ENABLE_WORKER=true (pg-boss). Vercel: ENABLE_WORKER är irrelevant;
# Vercel Cron anropar /v1/internal/cron/:job med Bearer CRON_SECRET.
CRON_SECRET=

# Sluten beta (docs/reports/BETA_READINESS_2026-09-03.md B7). Kommaseparerade
# inbjudningskoder; tom = öppen registrering. BETA_MODE=true visar beta-märket.
BETA_INVITE_CODES=
BETA_MODE=
# Vakthundsjobbet (/v1/internal/cron/watchdog, A9): dit larm mejlas när
# databasen, källorna, betalningskedjan eller granskningskön bryter tröskeln.
# Kräver RESEND_API_KEY eller SMTP_URL; utan adress loggas larmen bara.
ALERT_EMAIL=

# ── E-post (Resend är den påkopplade kanalen) ────────────────────────────────
# I produktion sätts RESEND_API_KEY + EMAIL_FROM (verifierad avsändardomän i
# Resend). Kanalen används för lösenordsåterställningslänkar och för att
# skicka kvitton ("Skicka kvittot via e-post" i Mina köp). Kvittot är
# fortfarande förstaklass i kontot — läsbart och nedladdningsbart som PDF
# även utan e-post. Utan kanal stänger länk-återställningen fail-closed (503);
# den kanal-lösa reservvägen är engångs-återställningskoder (Konto & data).
# SMTP_URL finns som alternativ kanal för självhostad drift.
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=

# ── Betalningar ──────────────────────────────────────────────────────────────
# Momsen är fast 25 % (standardsats för elektroniskt levererade tjänster till
# konsument i Sverige) och är medvetet inte konfigurerbar — se apps/api/src/config.ts.
# Säljaruppgifterna nedan är Landvex AB:s riktiga uppgifter och är även
# standardvärden i koden — sätt bara vid ändrade bolagsuppgifter.
# 19 kr per ansökan som förbereds i systemet (alla dokument för den ansökan ingår).
APPLICATION_PRICE_MINOR=1900
SELLER_NAME=Landvex AB
SELLER_ORG_NUMBER=559141-7042
SELLER_VAT_NUMBER=SE559141704201
SELLER_ADDRESS=Antennvägen 2, 135 48 Tyresö
# Swish Handel (Commerce API). Aktiveras först med handelsavtal + mTLS-
# certifikat från banken; adaptern vägrar ärligt (503) tills dess.
# Certifikat och nyckel som BASE64-kodad PEM (serverless har inget filsystem):
#   base64 -w0 swish.pem  →  SWISH_CERT_BASE64
SWISH_MERCHANT_ALIAS=
SWISH_CERT_BASE64=
SWISH_KEY_BASE64=
SWISH_KEY_PASSPHRASE=
# Test/preview: peka mot MSS-simulatorn https://mss.cpc.getswish.net
SWISH_API_BASE=
SWISH_QR_BASE=
SWISH_CA_BASE64=
# Stripe Checkout (kort m.m.) — lanseringsrälsen medan Swish-avtalet dröjer.
# STRIPE_SECRET_KEY aktiverar providern; STRIPE_WEBHOOK_SECRET krävs för att
# bekräfta betalningar (den signerade webhooken är sanningskällan). Utan nycklar
# vägrar köpytan ärligt 503. Konfigurera en webhook-endpoint i Stripe mot
# <PUBLIC_BASE_URL>/v1/webhooks/payments/stripe (event: checkout.session.completed)
# och klistra in dess signing secret som STRIPE_WEBHOOK_SECRET. Använd test-nycklar
# (sk_test_…/whsec_…) i preview, live-nycklar först i produktion. Se docs/ACTIVATION.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_API_BASE pekas bara om i integrationstester (lokal emulator).
STRIPE_API_BASE=
# Utveckling/test + Vercel PREVIEW (VERCEL_ENV=preview). Ignoreras alltid i
# skarp produktion — sätt den ENDAST i Preview-miljön på Vercel.
PAYMENTS_MOCK_ENABLED=

# ── Språkförslag (generation mode) ───────────────────────────────────────────
# Aktiveras av ANTHROPIC_API_KEY (modell claude-opus-5 via officiella SDK:n).
# Utan nyckel svarar förslagsytan ärligt 503. Varje förslag passerar de
# deterministiska vakterna i @bidrag/core och sparas aldrig automatiskt —
# sökanden godkänner själv. Se docs/ACTIVATION.md.
ANTHROPIC_API_KEY=
# Endast utveckling/test — ignoreras alltid i produktion.
GENERATION_MOCK_ENABLED=

# ── Valfritt ─────────────────────────────────────────────────────────────────
CLAMAV_ADDRESS=

# ── Sessioner & uppladdningar (valfria — rimliga standardvärden i koden) ─────
# HOST=0.0.0.0                    # adressen servern binder till
# ACCESS_TOKEN_TTL=900            # åtkomsttokens livslängd i sekunder
# REFRESH_TOKEN_TTL_DAYS=30       # refresh-tokens livslängd i dagar
# MAX_UPLOAD_BYTES=20971520       # största tillåtna uppladdning (20 MB)

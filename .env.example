# Bidrag.se configuration. In Kubernetes these come from Secrets/ConfigMaps.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres@localhost:5432/bidrag

# Secrets — REQUIRED in production, generate with: openssl rand -hex 32
AUTH_SECRET=
FIELD_ENCRYPTION_KEY=

# Session lifetimes
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520
# ClamAV daemon (host:port) — uploads are marked scan_unavailable when unset
CLAMAV_ADDRESS=

# Web
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Path to the built SPA for single-container serving (set in the image)
# WEB_DIST=./apps/web/dist

# Email notifications (optional; recorded as skipped when unset)
SMTP_URL=
EMAIL_FROM=no-reply@bidrag.se

# Worker (pg-boss). Set to false to run the API without background jobs.
ENABLE_WORKER=true

LOG_LEVEL=info

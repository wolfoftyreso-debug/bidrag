# Bidrag.se — miljövariabler. Kopiera till .env.local för lokal utveckling.
# COMMITTA ALDRIG riktiga värden. Produktionsvärden läggs i Vercels
# Environment Variables (separata värden för Development/Preview/Production).
# En hemlighet som råkat hamna i Git är komprometterad och SKA roteras.

# ── Databas (Supabase PostgreSQL) ────────────────────────────────────────────
# Runtime: poolad anslutning (Supavisor, port 6543, transaction mode).
DATABASE_URL=
# Migreringar/seed: direktanslutning (port 5432) — kör aldrig migreringar via poolern.
DIRECT_DATABASE_URL=
# Serverless: håll poolen liten per funktionsinstans.
PG_POOL_MAX=2

# ── Auth & kryptering ────────────────────────────────────────────────────────
# Minst 32 tecken; rotera vid misstanke om läckage.
AUTH_SECRET=
# 32 byte hex (64 tecken) för fältkryptering av externa identifierare.
FIELD_ENCRYPTION_KEY=

# ── Applikation ──────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=
CORS_ORIGIN=
LOG_LEVEL=info
RATE_LIMIT_MAX=300

# ── Lagring (dokumentvalvet) ─────────────────────────────────────────────────
# 'disk' lokalt/i container; 'supabase' på Vercel (privat bucket, service-nyckel
# enbart server-side).
STORAGE_DRIVER=disk
UPLOAD_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ── Bakgrundsjobb ────────────────────────────────────────────────────────────
# Container: ENABLE_WORKER=true (pg-boss). Vercel: ENABLE_WORKER är irrelevant;
# Vercel Cron anropar /v1/internal/cron/:job med Bearer CRON_SECRET.
CRON_SECRET=

# ── E-post (VALFRI — inget produktionskrav) ──────────────────────────────────
# Kvitton är förstaklass i kontot (Mina köp), notiser finns i Inkorgen och
# inbjudningar har delbara länkar. En kanal här är enbart best-effort-dublett.
# OBS: lösenordsåterställning kräver en kanal — utan den är den ytan
# avstängd fail-closed (503). Se docs/LIMITATIONS.md §4 (produktbeslut).
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=

# ── Betalningar ──────────────────────────────────────────────────────────────
# Momsen är fast 25 % (standardsats för elektroniskt levererade tjänster till
# konsument i Sverige) och är medvetet inte konfigurerbar — se apps/api/src/config.ts.
# Säljaruppgifterna nedan är Landvex AB:s riktiga uppgifter och är även
# standardvärden i koden — sätt bara vid ändrade bolagsuppgifter.
ANALYSIS_PRICE_MINOR=3900
SELLER_NAME=Landvex AB
SELLER_ORG_NUMBER=559141-7042
SELLER_VAT_NUMBER=SE559141704201
SELLER_ADDRESS=Antennvägen 2, 135 48 Tyresö
# Swish Handel (Commerce API). Aktiveras först med handelsavtal + mTLS-
# certifikat från banken; adaptern vägrar ärligt (503) tills dess.
# Certifikat och nyckel som BASE64-kodad PEM (serverless har inget filsystem):
#   base64 -w0 swish.pem  →  SWISH_CERT_BASE64
SWISH_MERCHANT_ALIAS=
SWISH_CERT_BASE64=
SWISH_KEY_BASE64=
SWISH_KEY_PASSPHRASE=
# Test/preview: peka mot MSS-simulatorn https://mss.cpc.getswish.net
SWISH_API_BASE=
SWISH_QR_BASE=
SWISH_CA_BASE64=
# Endast utveckling/test — ignoreras alltid i produktion.
PAYMENTS_MOCK_ENABLED=

# ── Valfritt ─────────────────────────────────────────────────────────────────
CLAMAV_ADDRESS=
